# De dónde lee el dashboard: auto (API y, si no responde, mock), api o mock.
VITE_DATA_SOURCE=auto
# Ruta de la API en el mismo origen. No cambiar en producción.
VITE_API_BASE=/api
# Cada cuántos segundos se consulta la API para ver si hay datos nuevos.
VITE_POLL_SECONDS=30
# Solo en local: dónde escucha FastAPI (lo usa el proxy de Vite).
API_PROXY_TARGET=http://localhost:8000
