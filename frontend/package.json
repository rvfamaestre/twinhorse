{
  "name": "lossia-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "mock": "python scripts/build_mock.py",
    "sim:check": "esbuild scripts/sim_check.ts --bundle --platform=node --format=esm --outfile=node_modules/.sim_check.mjs --log-level=warning && node node_modules/.sim_check.mjs",
    "snake:check": "esbuild scripts/snake_check.ts --bundle --platform=node --format=esm --outfile=node_modules/.snake_check.mjs --log-level=warning && node node_modules/.snake_check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
